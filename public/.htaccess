# Apache — configuración de despliegue de eco1516.org
#
# El sitio se publica con URLs sin extensión (/ayuda, /proyecto). En disco
# esos archivos son ayuda.html y proyecto.html, así que sin estas reglas cada
# página daría 404 menos la portada. Es lo primero que hay que comprobar
# después de subir.

# --- URLs limpias ---------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Forzar HTTPS y el dominio con www, que es el canónico del sitio.
  RewriteCond %{HTTPS} !=on
  RewriteRule ^(.*)$ https://www.eco1516.org/$1 [R=301,L]
  RewriteCond %{HTTP_HOST} !^www\. [NC]
  RewriteRule ^(.*)$ https://www.eco1516.org/$1 [R=301,L]

  # /ayuda -> ayuda.html, si ese archivo existe.
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}\.html -f
  RewriteRule ^(.*)$ $1.html [L]

  # Quitar .html de la barra si alguien llega con él, para no tener la misma
  # página en dos direcciones.
  RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L]
</IfModule>

# --- Compresión -----------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/plain text/xml
</IfModule>

# --- Caché ----------------------------------------------------------------
# Los assets llevan hash en el nombre, así que pueden cachearse un año. El
# HTML no: tiene que poder cambiar el mismo día que se publica.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html                 "access plus 0 seconds"
  ExpiresByType text/css                  "access plus 1 year"
  ExpiresByType application/javascript    "access plus 1 year"
  ExpiresByType image/png                 "access plus 1 year"
  ExpiresByType image/svg+xml             "access plus 1 year"
  ExpiresByType font/woff2                "access plus 1 year"
  ExpiresByType text/plain                "access plus 1 day"
  ExpiresByType application/xml           "access plus 1 day"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|png|svg|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# --- Tipos y errores ------------------------------------------------------
AddType text/plain .txt
AddDefaultCharset UTF-8
ErrorDocument 404 /404.html
